{
    "$schema": "https://railway.com/railway.schema.json",
    "build": {
        "rootDirectory": "backend",
        "builder": "RAILPACK",
        "watchPatterns": [
            "/backend/**"
        ]
    },
    "deploy": {
        "startCommand": "alembic upgrade head && uvicorn app.main:app --host 0.0.0.0 --port $PORT",
        "restartPolicyType": "ON_FAILURE",
        "restartPolicyMaxRetries": 10
    }
}