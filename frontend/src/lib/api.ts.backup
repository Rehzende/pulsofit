                    // Workout Groups
                    getWorkoutGroups: async (): Promise<WorkoutGroup[]> => {
                        const response = await api.get<WorkoutGroup[]>('/workout-groups/');
                        return response.data;
                    },

                        createWorkoutGroup: async (name: string): Promise<WorkoutGroup> => {
                            const response = await api.post<WorkoutGroup>('/workout-groups/', { name });
                            return response.data;
                        },

                            updateWorkoutGroup: async (id: string, name: string): Promise<WorkoutGroup> => {
                                const response = await api.put<WorkoutGroup>(`/workout-groups/${id}`, { name });
                                return response.data;
